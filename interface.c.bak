  gtk_fixed_put (GTK_FIXED (fixed11), image63, 24, 48);
  gtk_widget_set_size_request (image63, 112, 104);

  label296 = gtk_label_new (_("<span size=\"18000\" color=\"#007766\" style=\"italic\" ><b>Connexion</b></span>\n"));
  gtk_widget_show (label296);
  gtk_fixed_put (GTK_FIXED (fixed11), label296, 144, 0);
  gtk_widget_set_size_request (label296, 168, 40);
  gtk_label_set_use_markup (GTK_LABEL (label296), TRUE);

  label51 = gtk_label_new (_("<span size=\"12000\" ><b>Username</b></span>\n"));
