  gtk_widget_set_size_request (entry_password, 160, 27);
  gtk_entry_set_invisible_char (GTK_ENTRY (entry_password), 8226);

  image62 = create_pixmap (Login_users, "images.png");
  gtk_widget_show (image62);
  gtk_fixed_put (GTK_FIXED (fixed11), image62, 24, 192);
  gtk_widget_set_size_request (image62, 112, 112);

  label52 = gtk_label_new (_("<span size=\"12000\" ><b>Password</b></span>\n"));
  gtk_widget_show (label52);
