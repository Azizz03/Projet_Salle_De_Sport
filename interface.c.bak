  gtk_widget_set_size_request (label51, 152, 25);
  gtk_label_set_use_markup (GTK_LABEL (label51), TRUE);

  g_signal_connect ((gpointer) button_login, "clicked",
                    G_CALLBACK (on_button_login_clicked),
