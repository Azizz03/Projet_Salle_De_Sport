  GLADE_HOOKUP_OBJECT (Login_users, image30, "image30");
  GLADE_HOOKUP_OBJECT (Login_users, label_login, "label_login");
  GLADE_HOOKUP_OBJECT (Login_users, btn_login, "btn_login");
  GLADE_HOOKUP_OBJECT (Login_users, alignment29, "alignment29");
  GLADE_HOOKUP_OBJECT (Login_users, hbox29, "hbox29");
  GLADE_HOOKUP_OBJECT (Login_users, image31, "image31");
  GLADE_HOOKUP_OBJECT (Login_users, label_seconnecter, "label_seconnecter");

  return Login_users;
}

