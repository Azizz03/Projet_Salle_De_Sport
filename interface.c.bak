  GtkWidget *hbox29;
  GtkWidget *image31;
  GtkWidget *label53;
  GtkWidget *image63;
  GtkWidget *label296;
  GtkWidget *label51;

  Login_users = gtk_window_new (GTK_WINDOW_TOPLEVEL);
  gtk_window_set_title (GTK_WINDOW (Login_users), _("Users_login"));

  fixed11 = gtk_fixed_new ();
  gtk_widget_show (fixed11);
  gtk_container_add (GTK_CONTAINER (Login_users), fixed11);

  entry_username = gtk_entry_new ();
