  gtk_widget_set_size_request (label52, 150, 25);
  gtk_label_set_use_markup (GTK_LABEL (label52), TRUE);

  button_login = gtk_button_new ();
  gtk_widget_show (button_login);
  gtk_fixed_put (GTK_FIXED (fixed11), button_login, 160, 320);
  gtk_widget_set_size_request (button_login, 144, 29);

  alignment29 = gtk_alignment_new (0.5, 0.5, 0, 0);
  gtk_widget_show (alignment29);
  gtk_container_add (GTK_CONTAINER (button_login), alignment29);

  hbox29 = gtk_hbox_new (FALSE, 2);
