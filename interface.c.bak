  GLADE_HOOKUP_OBJECT (Login_users, image31, "image31");
  GLADE_HOOKUP_OBJECT (Login_users, label53, "label53");
  GLADE_HOOKUP_OBJECT (Login_users, image63, "image63");
  GLADE_HOOKUP_OBJECT (Login_users, label296, "label296");
  GLADE_HOOKUP_OBJECT (Login_users, label51, "label51");

  return Login_users;
}

