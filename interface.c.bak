  gtk_box_pack_start (GTK_BOX (hbox50), label313, FALSE, FALSE, 0);
  gtk_label_set_use_markup (GTK_LABEL (label313), TRUE);

  label304 = gtk_label_new (_("<span size=\"18000\" color=\"#007766\" style=\"italic\" ><b>Inscription </b></span>\n"));
  gtk_widget_show (label304);
  gtk_fixed_put (GTK_FIXED (fixed42), label304, 152, 16);
  gtk_widget_set_size_request (label304, 120, 33);
  gtk_label_set_use_markup (GTK_LABEL (label304), TRUE);

  image78 = create_pixmap (inscription, "sp.jpeg");
  gtk_widget_show (image78);
  gtk_fixed_put (GTK_FIXED (fixed42), image78, 352, 176);
  gtk_widget_set_size_request (image78, 248, 200);

  g_signal_connect ((gpointer) button_inscription, "clicked",
                    G_CALLBACK (on_button_inscription_clicked),
                    NULL);

  /* Store pointers to all widgets, for use by lookup_widget(). */
  GLADE_HOOKUP_OBJECT_NO_REF (inscription, inscription, "inscription");
  GLADE_HOOKUP_OBJECT (inscription, fixed42, "fixed42");
  GLADE_HOOKUP_OBJECT (inscription, entry_nom, "entry_nom");
  GLADE_HOOKUP_OBJECT (inscription, entry_prenom, "entry_prenom");
  GLADE_HOOKUP_OBJECT (inscription, entry_password, "entry_password");
  GLADE_HOOKUP_OBJECT (inscription, entry_username, "entry_username");
  GLADE_HOOKUP_OBJECT (inscription, entry_role, "entry_role");
  GLADE_HOOKUP_OBJECT (inscription, label305, "label305");
  GLADE_HOOKUP_OBJECT (inscription, label306, "label306");
  GLADE_HOOKUP_OBJECT (inscription, label307, "label307");
  GLADE_HOOKUP_OBJECT (inscription, label308, "label308");
  GLADE_HOOKUP_OBJECT (inscription, label309, "label309");
  GLADE_HOOKUP_OBJECT (inscription, label310, "label310");
  GLADE_HOOKUP_OBJECT (inscription, button_inscription, "button_inscription");
  GLADE_HOOKUP_OBJECT (inscription, alignment50, "alignment50");
  GLADE_HOOKUP_OBJECT (inscription, hbox50, "hbox50");
  GLADE_HOOKUP_OBJECT (inscription, image75, "image75");
  GLADE_HOOKUP_OBJECT (inscription, label313, "label313");
  GLADE_HOOKUP_OBJECT (inscription, label304, "label304");
  GLADE_HOOKUP_OBJECT (inscription, image78, "image78");

  return inscription;
}

